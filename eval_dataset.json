{
  "project": "Personal Travel Planner Agent",
  "evaluation_version": "1.0",
  "test_cases": [
    {
      "id": "TC01",
      "category": "normal_travel_request",
      "input": "Plan a 3-day trip to Jaipur with a budget of ₹15,000. I like history and local food.",
      "expected_behavior": {
        "should_answer": true,
        "destination": "Jaipur",
        "duration_days": 3,
        "budget": 15000,
        "preferences": [
          "history",
          "local food"
        ],
        "expected_points": [
          "Provides a 3-day itinerary",
          "Includes Jaipur attractions",
          "Prioritizes historical places",
          "Includes local food suggestions",
          "Considers the ₹15,000 budget"
        ]
      },
      "expected_tools": [
        "get_destination_info",
        "estimate_budget",
        "sum_entry_fees"
      ]
    },
    {
      "id": "TC02",
      "category": "normal_travel_request",
      "input": "Plan a 5-day trip to Delhi with a budget of ₹25,000. I want to explore monuments, markets and local food.",
      "expected_behavior": {
        "should_answer": true,
        "destination": "Delhi",
        "duration_days": 5,
        "budget": 25000,
        "preferences": [
          "monuments",
          "markets",
          "local food"
        ],
        "expected_points": [
          "Provides a 5-day itinerary",
          "Includes Delhi monuments",
          "Includes markets",
          "Includes local food",
          "Considers the ₹25,000 budget"
        ]
      },
      "expected_tools": [
        "get_destination_info",
        "estimate_budget",
        "sum_entry_fees"
      ]
    },
    {
      "id": "TC03",
      "category": "low_budget",
      "input": "Plan a 3-day trip to Agra with a budget of ₹5,000. Keep the trip as affordable as possible.",
      "expected_behavior": {
        "should_answer": true,
        "destination": "Agra",
        "duration_days": 3,
        "budget": 5000,
        "expected_points": [
          "Provides a 3-day itinerary",
          "Keeps recommendations budget-friendly",
          "Uses low-cost activities and food suggestions",
          "Attempts to stay within ₹5,000"
        ]
      },
      "expected_tools": [
        "get_destination_info",
        "estimate_budget",
        "sum_entry_fees"
      ]
    },
    {
      "id": "TC04",
      "category": "missing_information",
      "input": "Plan a 4-day trip for me with a budget of ₹15,000.",
      "expected_behavior": {
        "should_answer": false,
        "missing_information": [
          "destination"
        ],
        "expected_points": [
          "Recognizes that destination is missing",
          "Asks the user for the destination",
          "Does not invent a destination"
        ]
      },
      "expected_tools": []
    },
    {
      "id": "TC05",
      "category": "missing_information",
      "input": "Plan a 4-day trip to Jaipur.",
      "expected_behavior": {
        "should_answer": true,
        "missing_information": [
          "budget"
        ],
        "expected_points": [
          "Recognizes that budget is missing",
          "Asks for or clearly handles the missing budget",
          "Does not invent a specific user budget"
        ]
      },
      "expected_tools": []
    },
    {
      "id": "TC06",
      "category": "invalid_input",
      "input": "Plan a 0-day trip to Jaipur with a budget of ₹10,000.",
      "expected_behavior": {
        "should_answer": false,
        "invalid_field": "duration",
        "expected_points": [
          "Recognizes that 0 days is invalid",
          "Does not generate a normal itinerary",
          "Requests a valid positive number of days"
        ]
      },
      "expected_tools": []
    },
    {
      "id": "TC07",
      "category": "invalid_input",
      "input": "Plan a 3-day trip to Jaipur with a budget of -₹10,000.",
      "expected_behavior": {
        "should_answer": false,
        "invalid_field": "budget",
        "expected_points": [
          "Recognizes that a negative budget is invalid",
          "Does not calculate a negative travel budget",
          "Requests a valid positive budget"
        ]
      },
      "expected_tools": []
    },
    {
      "id": "TC08",
      "category": "user_preference",
      "input": "Plan a 3-day trip to Udaipur with a budget of ₹18,000. I love historical places, lakes and photography.",
      "expected_behavior": {
        "should_answer": true,
        "destination": "Udaipur",
        "duration_days": 3,
        "budget": 18000,
        "preferences": [
          "historical places",
          "lakes",
          "photography"
        ],
        "expected_points": [
          "Provides a 3-day itinerary",
          "Includes historical places",
          "Includes lakes",
          "Includes photography-friendly locations",
          "Considers the ₹18,000 budget"
        ]
      },
      "expected_tools": [
        "get_destination_info",
        "estimate_budget",
        "sum_entry_fees"
      ]
    },
    {
      "id": "TC09",
      "category": "food_preference",
      "input": "Plan a 2-day trip to Delhi with a budget of ₹10,000. I am mainly interested in street food and local cuisine.",
      "expected_behavior": {
        "should_answer": true,
        "destination": "Delhi",
        "duration_days": 2,
        "budget": 10000,
        "preferences": [
          "street food",
          "local cuisine"
        ],
        "expected_points": [
          "Provides a 2-day itinerary",
          "Includes food-focused recommendations",
          "Includes local cuisine",
          "Includes street-food suggestions",
          "Considers the ₹10,000 budget"
        ]
      },
      "expected_tools": [
        "get_destination_info",
        "estimate_budget",
        "sum_entry_fees"
      ]
    },
    {
      "id": "TC10",
      "category": "out_of_scope",
      "input": "Explain how to create a Python virtual environment.",
      "expected_behavior": {
        "should_answer": false,
        "expected_points": [
          "Recognizes that the request is outside the travel-planning scope",
          "Politely refuses or redirects to travel planning",
          "Does not provide a Python tutorial"
        ]
      },
      "expected_tools": []
    }
  ]
}